DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000

NEXT_PUBLIC_USER_PORTAL_URL=http://localhost:3000
# Always served under /hr (set automatically by next.config; keep for clarity)
NEXT_PUBLIC_BASE_PATH=/hr
SESSION_COOKIE_DOMAIN=

EMAIL_PROVIDER=auto
RESEND_API_KEY=re_your-resend-api-key
EMAIL_DOMAIN=mail.yourdomain.com
EMAIL_FROM=noreply@mail.yourdomain.com
EMAIL_FROM_NAME=CareerVault
EMAIL_DEV_OTP_FALLBACK=true

# Optional: BREVO_API_KEY=xkeysib-your-brevo-api-key
